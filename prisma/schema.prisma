generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(cuid())
  name         String
  email        String       @unique
  passwordHash String
  collections  Collection[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Collection {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       Item[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model Item {
  id                       String             @id @default(cuid())
  collectionId             String
  brandId                  String
  model                    String
  manufacturerId           String
  scaleId                  String?
  countryId                String?
  companyId                String?
  purchaseDate             DateTime
  purchaseValue            Decimal?           @db.Decimal(12, 2)
  purchaseCurrencyId       String?
  purchaseConditionId      String
  isSold                   Boolean            @default(false)
  soldPrice                Decimal?           @db.Decimal(12, 2)
  soldCurrencyId           String?
  soldDate                 DateTime?
  estimatedValue           Decimal?           @db.Decimal(12, 2)
  estimatedValueCurrencyId String?
  estimatedValueDate       DateTime?
  conditionId              String?
  referenceNumber          String?
  locationId               String?
  notes                    String?
  collection               Collection         @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  brand                    Brand              @relation(fields: [brandId], references: [id], onDelete: Restrict)
  manufacturer             Manufacturer       @relation(fields: [manufacturerId], references: [id], onDelete: Restrict)
  scale                    Scale?             @relation(fields: [scaleId], references: [id], onDelete: SetNull)
  country                  Country?           @relation("ItemDisplayCountry", fields: [countryId], references: [id], onDelete: SetNull)
  company                  Company?           @relation(fields: [companyId], references: [id], onDelete: SetNull)
  purchaseCurrency         Currency?          @relation("PurchaseCurrency", fields: [purchaseCurrencyId], references: [id], onDelete: SetNull)
  purchaseCondition        PurchaseCondition  @relation(fields: [purchaseConditionId], references: [id], onDelete: Restrict)
  soldCurrency             Currency?          @relation("SoldCurrency", fields: [soldCurrencyId], references: [id], onDelete: SetNull)
  estimatedValueCurrency   Currency?          @relation("EstimatedValueCurrency", fields: [estimatedValueCurrencyId], references: [id], onDelete: SetNull)
  condition                Condition?         @relation(fields: [conditionId], references: [id], onDelete: SetNull)
  location                 Location?          @relation(fields: [locationId], references: [id], onDelete: SetNull)
  images                   ItemImage[]
  marketReferences         MarketReference[]
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  @@index([collectionId])
  @@index([brandId])
  @@index([manufacturerId])
  @@index([companyId])
  @@index([countryId])
  @@index([isSold])
}

model Brand {
  id        String   @id @default(cuid())
  name      String   @unique
  countryId String?
  country   Country? @relation("BrandCountry", fields: [countryId], references: [id], onDelete: SetNull)
  items     Item[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([countryId])
}

model Manufacturer {
  id        String   @id @default(cuid())
  name      String   @unique
  countryId String?
  country   Country? @relation("ManufacturerCountry", fields: [countryId], references: [id], onDelete: SetNull)
  items     Item[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([countryId])
}

model Company {
  id        String   @id @default(cuid())
  name      String   @unique
  countryId String?
  country   Country? @relation("CompanyCountry", fields: [countryId], references: [id], onDelete: SetNull)
  items     Item[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([countryId])
}

model Country {
  id            String         @id @default(cuid())
  name          String         @unique
  isoCode       String         @unique @db.VarChar(2)
  flagEmoji     String
  brands        Brand[]        @relation("BrandCountry")
  manufacturers Manufacturer[] @relation("ManufacturerCountry")
  companies     Company[]      @relation("CompanyCountry")
  displayItems  Item[]         @relation("ItemDisplayCountry")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Scale {
  id        String   @id @default(cuid())
  name      String   @unique
  sortOrder Int      @default(0)
  items     Item[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Condition {
  id        String   @id @default(cuid())
  name      String   @unique
  sortOrder Int      @default(0)
  items     Item[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PurchaseCondition {
  id        String   @id @default(cuid())
  name      String   @unique
  sortOrder Int      @default(0)
  items     Item[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Currency {
  id                       String            @id @default(cuid())
  code                     String            @unique @db.VarChar(3)
  symbol                   String
  name                     String
  purchaseItems            Item[]            @relation("PurchaseCurrency")
  soldItems                Item[]            @relation("SoldCurrency")
  estimatedValueItems      Item[]            @relation("EstimatedValueCurrency")
  marketReferences         MarketReference[]
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt
}

model Location {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  items       Item[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}


model ItemImage {
  id               String             @id @default(cuid())
  itemId           String
  storageProvider  String
  bucket           String
  objectKey        String
  publicUrl        String?
  originalFileName String
  mimeType         String
  sizeBytes        Int
  width            Int
  height           Int
  sortOrder        Int                @default(0)
  isCover          Boolean            @default(false)
  item             Item               @relation(fields: [itemId], references: [id], onDelete: Cascade)
  variants         ItemImageVariant[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@unique([bucket, objectKey])
  @@index([itemId])
  @@index([itemId, sortOrder])
}

model ItemImageVariant {
  id        String    @id @default(cuid())
  imageId   String
  variant   String
  objectKey String
  publicUrl String?
  width     Int
  height    Int
  sizeBytes Int
  image     ItemImage @relation(fields: [imageId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([imageId, variant])
  @@index([imageId])
}

model MarketReference {
  id            String    @id @default(cuid())
  itemId        String
  source        String
  url           String
  title         String?
  observedPrice Decimal?  @db.Decimal(12, 2)
  currencyId    String?
  observedAt    DateTime
  notes         String?
  item          Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  currency      Currency? @relation(fields: [currencyId], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([itemId])
  @@index([currencyId])
}
